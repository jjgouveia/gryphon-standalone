{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019JN1d8kXYZGMdbALmfhkWP","type":"tool_result","content":"1\timport { expect } from '@jest/globals';\n2\timport { Permissions } from '@/enums/permissions.enum';\n3\t\n4\timport { canAccessGlobalSearch, enabledGlobalSearchSections } from '../global-search-access';\n5\t\n6\tdescribe('global-search-access', () => {\n7\t    it('libera com view_proposal_search', () => {\n8\t        expect(canAccessGlobalSearch([Permissions.VIEW_PROPOSAL_SEARCH])).toBe(true);\n9\t    });\n10\t\n11\t    it('libera com due (dashboard jurídico ou broker due 2)', () => {\n12\t        expect(canAccessGlobalSearch([Permissions.VIEW_DASHBOARD_JURIDICO])).toBe(true);\n13\t        expect(canAccessGlobalSearch([Permissions.VIEW_BROKER_DUE_DILIGENCE_2])).toBe(true);\n14\t    });\n15\t\n16\t    it('libera com pós-aquisição', () => {\n17\t        expect(canAccessGlobalSearch([Permissions.VIEW_POS_AQUISICAO])).toBe(true);\n18\t    });\n19\t\n20\t    it('lista seções habilitadas para chips', () => {\n21\t        expect(enabledGlobalSearchSections([Permissions.VIEW_PROPOSAL_SEARCH])).toEqual([\n22\t            'propostas',\n23\t        ]);\n24\t        expect(\n25\t            enabledGlobalSearchSections([\n26\t                Permissions.VIEW_PROPOSAL_SEARCH,\n27\t                Permissions.VIEW_DASHBOARD_JURIDICO,\n28\t                Permissions.VIEW_POS_AQUISICAO,\n29\t            ]),\n30\t        ).toEqual(['propostas', 'due', 'pos']);\n31\t    });\n32\t\n33\t    it('nega sem nenhuma seção', () => {\n34\t        expect(canAccessGlobalSearch([Permissions.READ, 'view_crm_universal'])).toBe(false);\n35\t        expect(canAccessGlobalSearch([])).toBe(false);\n36\t        expect(canAccessGlobalSearch(null)).toBe(false);\n37\t        expect(enabledGlobalSearchSections([])).toEqual([]);\n38\t    });\n39\t});\n40\t"}]},"parent_tool_use_id":null,"session_id":"ec2d9279-6af2-43b6-90df-7cf81b80c4a5","uuid":"ecb70401-4c2a-468a-8e60-6a181f7ff487","timestamp":"2026-10-06T12:11:40.056Z","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/gouvi/AppData/Local/Temp/rab/b5ec23519869/repo/src/functions/__tests__/global-search-access.test.ts","content":"import { expect } from '@jest/globals';\nimport { Permissions } from '@/enums/permissions.enum';\n\nimport { canAccessGlobalSearch, enabledGlobalSearchSections } from '../global-search-access';\n\ndescribe('global-search-access', () => {\n    it('libera com view_proposal_search', () => {\n        expect(canAccessGlobalSearch([Permissions.VIEW_PROPOSAL_SEARCH])).toBe(true);\n    });\n\n    it('libera com due (dashboard jurídico ou broker due 2)', () => {\n        expect(canAccessGlobalSearch([Permissions.VIEW_DASHBOARD_JURIDICO])).toBe(true);\n        expect(canAccessGlobalSearch([Permissions.VIEW_BROKER_DUE_DILIGENCE_2])).toBe(true);\n    });\n\n    it('libera com pós-aquisição', () => {\n        expect(canAccessGlobalSearch([Permissions.VIEW_POS_AQUISICAO])).toBe(true);\n    });\n\n    it('lista seções habilitadas para chips', () => {\n        expect(enabledGlobalSearchSections([Permissions.VIEW_PROPOSAL_SEARCH])).toEqual([\n            'propostas',\n        ]);\n        expect(\n            enabledGlobalSearchSections([\n                Permissions.VIEW_PROPOSAL_SEARCH,\n                Permissions.VIEW_DASHBOARD_JURIDICO,\n                Permissions.VIEW_POS_AQUISICAO,\n            ]),\n        ).toEqual(['propostas', 'due', 'pos']);\n    });\n\n    it('nega sem nenhuma seção', () => {\n        expect(canAccessGlobalSearch([Permissions.READ, 'view_crm_universal'])).toBe(false);\n        expect(canAccessGlobalSearch([])).toBe(false);\n        expect(canAccessGlobalSearch(null)).toBe(false);\n        expect(enabledGlobalSearchSections([])).toEqual([]);\n    });\n});\n","numLines":40,"startLine":1,"totalLines":40}}}
